@using MultiverseRumble.Models
@model List<Escenario>
@{
    ViewData["Title"] = "Escenarios";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Escenarios - Multiverse Rumble</title>
    <link rel="stylesheet" href="~/css/site-arcade.css" />
</head>
<body class="mr-body">
    <h1 class="mr-title" style="font-size:1.6rem;">ESCENARIOS</h1>
    <p class="mr-subtitle">MUNDOS DE BATALLA</p>

    <div class="mr-stage-strip" style="flex-wrap:wrap; justify-content:center;">
        @foreach (var e in Model)
        {
            <a href="@Url.Action("Detalle", "Escenario", new { id = e.Id })" style="text-decoration:none; color:inherit;">
                <div class="mr-stage-card">
                    <div class="mr-stage-thumb"></div>
                    <div class="mr-card-name" style="font-size:.95rem;">@e.Nombre</div>
                    <div class="mr-card-sub">@e.Universo</div>
                </div>
            </a>
        }
    </div>

    <a class="mr-back-link" href="@Url.Action("Index", "Home")">&lt; volver al menú</a>
</body>
</html>